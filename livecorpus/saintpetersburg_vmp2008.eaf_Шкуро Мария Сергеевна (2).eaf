    <TIER ANNOTATOR="Шкуро Мария Сергеевна" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="Паньков Вячеслав Михайлович" TIER_ID="text@vmp2008m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a10"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>есть калиграфия // этим / два года занимаюсь / собственно фотография / уже набра= уже назвал</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts45">
                <ANNOTATION_VALUE>получается / года четыре // э</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts47" TIME_SLOT_REF2="ts71">
                <ANNOTATION_VALUE>в какое-то время / разрабатывал / э / моды на игры / и делал=</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts72" TIME_SLOT_REF2="ts88">
                <ANNOTATION_VALUE>держал сервер / собственно сами видеоигры /</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts89" TIME_SLOT_REF2="ts99">
                <ANNOTATION_VALUE>считается ли прослушивание музыки хобби?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts137" TIME_SLOT_REF2="ts195">
                <ANNOTATION_VALUE>чтоб прям / чего-то сильно / бояться не думаю / ну какие-то были базовые страхи / вроде темноты и высоты / но это само собой прошло / эм / </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts197" TIME_SLOT_REF2="ts219">
                <ANNOTATION_VALUE>высоты=  те= темноты вот вообще помогло просто в какой-то момент осознание</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts220" TIME_SLOT_REF2="ts249">
                <ANNOTATION_VALUE>ну ничего же не сущесвует / так и чего бояться / это реально сработало</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts251" TIME_SLOT_REF2="ts283">
                <ANNOTATION_VALUE>некий был страх / а / потери времени // но это // скорее не детский страх / аа // скорее мысль</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
