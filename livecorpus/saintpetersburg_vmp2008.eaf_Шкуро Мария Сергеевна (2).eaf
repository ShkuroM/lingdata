                TIME_SLOT_REF1="ts284" TIME_SLOT_REF2="ts339">
                <ANNOTATION_VALUE>а// не знаю |/ часто я отвечаю // на что-то / я= я не компетентен чтобы судить об этом / потому что понимаю / что слишком мало знаю но в целом // думаю // можно сказать что да</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
